# Dockerfile_scratch_dev_frontend — Node development container.
# Runs webpack in watch mode; rebuilt assets land in assets/static/ inside
# the shared source volume and are served directly by the backend container.

FROM node:22-bookworm-slim

# Set workspace root — npm ci must run here so it can read the root lockfile.
WORKDIR /photoprism

# Copy workspace manifests; this layer is cached until either file changes.
# package-lock.json lives at the project root (npm workspace, see #5458).
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/

# Install all workspace dependencies into /photoprism/node_modules.
# That directory is outside the ./frontend volume mount, so it survives at runtime.
RUN npm install

# node_modules is baked into the image.
# frontend/src/ and assets/static/ are mounted at runtime via compose volumes.
WORKDIR /photoprism/frontend
CMD ["npm", "run", "watch"]
